rules_version = '2';

// TEST MODE. Anyone can read and write until the date below, like Firebase's own test mode.
// Guests also write (listen stats, recommendation interactions), so writes are not limited to
// signed-in users yet. Before going public, replace this with per-collection rules:
// see docs/FIREBASE.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
