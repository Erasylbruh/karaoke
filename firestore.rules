rules_version = '2';

// Public: tracks, public profiles, reviews, playlists, follower lists.
// Private: email and moderation details (userPrivate), notifications, download history, likes,
// author stats. The app reads private collections only through queries limited to the signed-in
// person (lib/store.ts setSyncScope), so every rule below can stay owner-only.
service cloud.firestore {
  match /databases/{database}/documents {
    function userPath(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    function projectPath(id) {
      return /databases/$(database)/documents/karaokes/$(id);
    }

    function adminLinkPath(uid) {
      return /databases/$(database)/documents/legacyAdminProfiles/$(uid);
    }

    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(id) {
      return signedIn() && exists(userPath(id)) &&
        get(userPath(id)).data.get('uid', id) == request.auth.uid;
    }

    function isAdminProfile(id) {
      return ownsProfile(id) && get(userPath(id)).data.role == 'admin';
    }

    function isAdmin() {
      return signedIn() && (
        isAdminProfile(request.auth.uid) ||
        (exists(adminLinkPath(request.auth.uid)) &&
          isAdminProfile(get(adminLinkPath(request.auth.uid)).data.profileId))
      );
    }

    function isModerationNotification(data) {
      return data.get('type', '') in ['warning', 'ban'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function changes(key) {
      return changedKeys().hasAny([key]);
    }

    // ---------------- Profiles ----------------

    match /users/{id} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == id &&
        request.resource.data.id == id && request.resource.data.uid == id &&
        request.resource.data.role == 'user' && request.resource.data.get('status', 'active') == 'active' &&
        !request.resource.data.keys().hasAny(['email', 'warnings', 'banReason', 'banUntil']);
      allow update: if isAdmin() || (
        ownsProfile(id) &&
        changedKeys().hasOnly(['username', 'name', 'avatar', 'bio', 'contacts', 'seenTutorials', 'email']) &&
        // An old public email may stay as it is or be removed, never be set or changed.
        (!changes('email') || !request.resource.data.keys().hasAny(['email']))
      );
      allow delete: if isAdmin();

      match /projectWarnings/{warningId} {
        allow read: if ownsProfile(id) || isAdmin();
        allow create: if isAdminProfile(request.resource.data.moderatorId) &&
          request.resource.data.keys().hasOnly(['karaokeId', 'karaokeTitle', 'moderatorId', 'reason', 'createdAt', 'read']) &&
          exists(userPath(id)) && warningTargetsProject(id) &&
          request.resource.data.reason is string && request.resource.data.reason.size() <= 1000 &&
          request.resource.data.reason.matches('(?s).*\\S.*') &&
          request.resource.data.createdAt == request.time && request.resource.data.read == false;
        allow update: if ownsProfile(id) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
          request.resource.data.read == true;

        function warningTargetsProject(authorId) {
          let project = getAfter(projectPath(request.resource.data.karaokeId)).data;
          return project.authorId == authorId && project.title == request.resource.data.karaokeTitle &&
            project.get('status', 'active') != 'deleted';
        }
      }
    }

    // Email and moderation details: the owner and admins only.
    match /userPrivate/{id} {
      allow read: if (signedIn() && request.auth.uid == id) || isAdmin();
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == id &&
        request.resource.data.keys().hasOnly(['id', 'email']) &&
        request.resource.data.email == request.auth.token.email
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == id && changedKeys().hasOnly(['email']) &&
        request.resource.data.email == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    match /legacyAdminProfiles/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['profileId']) && isAdminProfile(request.resource.data.profileId);
    }

    // ---------------- Tracks ----------------

    match /karaokes/{id} {
      allow read: if true;
      allow create: if ownsProfile(request.resource.data.authorId) &&
        request.resource.data.id == id && request.resource.data.get('status', 'active') == 'active';
      allow update: if isAdmin() || (
        ownsProfile(resource.data.authorId) && request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.get('id', id) == resource.data.get('id', id) &&
        (request.resource.data.get('status', 'active') == resource.data.get('status', 'active') ||
          request.resource.data.status == 'deleted')
      );
      // Listeners (guests too) move the counters, one step at a time.
      allow update: if changedKeys().hasOnly(['viewsCount', 'likesCount', 'recommendationScore', 'isFeatured']) &&
        (!changes('viewsCount') ||
          request.resource.data.viewsCount == resource.data.get('viewsCount', 0) + 1) &&
        (!changes('likesCount') || (signedIn() &&
          request.resource.data.likesCount - resource.data.get('likesCount', 0) in [-1, 1] &&
          request.resource.data.likesCount >= 0)) &&
        (!changes('recommendationScore') || (
          request.resource.data.recommendationScore > resource.data.get('recommendationScore', 0) &&
          request.resource.data.recommendationScore - resource.data.get('recommendationScore', 0) <= 4 &&
          request.resource.data.recommendationScore <= 100)) &&
        (!changes('isFeatured') || (request.resource.data.isFeatured == true &&
          request.resource.data.get('recommendationScore', 0) >= 60));
      allow delete: if isAdmin();
    }

    // Once per (track, actor, action): created, never changed. Read one by one, never listed.
    match /interactions/{key} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is string;
    }

    // ---------------- Reviews ----------------

    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.id == id &&
        request.resource.data.keys().hasOnly(['id', 'karaokeId', 'userId', 'userName', 'userAvatar', 'content', 'createdAt', 'parentId']) &&
        request.resource.data.content is string && request.resource.data.content.size() <= 1000 &&
        exists(projectPath(request.resource.data.karaokeId));
      // Pinning: the track author or an admin.
      allow update: if changedKeys().hasOnly(['pinned']) && (
        isAdmin() || (signedIn() && get(projectPath(resource.data.karaokeId)).data.authorId == request.auth.uid)
      );
      // The review's author or an admin; deleting a review also removes the replies to it.
      allow delete: if isAdmin() || (signedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.get('parentId', null) != null &&
          get(/databases/$(database)/documents/comments/$(resource.data.parentId)).data.userId == request.auth.uid)
      ));
    }

    // ---------------- Social ----------------

    match /playlists/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.id == id;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // follows/{authorId}.followers: each person can only add or remove themselves.
    match /follows/{targetId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['id', 'followers']) &&
        request.resource.data.followers.toSet().hasOnly([request.auth.uid]);
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['id', 'followers']) &&
        request.resource.data.followers.toSet().difference(resource.data.followers.toSet())
          .union(resource.data.followers.toSet().difference(request.resource.data.followers.toSet()))
          .hasOnly([request.auth.uid]);
    }

    // likes/{uid}.ids: the person's own liked tracks.
    match /likes/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------------- Personal ----------------

    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if request.resource.data.id == id && request.resource.data.read == false &&
        request.resource.data.keys().hasOnly(['id', 'userId', 'type', 'text', 'createdAt', 'read', 'actorId', 'actorName', 'karaokeId', 'karaokeTitle', 'commentId']) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 500 && (
          (isModerationNotification(request.resource.data) && isAdmin()) ||
          (!isModerationNotification(request.resource.data) && signedIn() &&
            request.resource.data.actorId == request.auth.uid && request.resource.data.userId != request.auth.uid)
        );
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        changedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid && !isModerationNotification(resource.data);
    }

    match /downloads/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.id == id;
    }

    // Daily author stats: anyone's action adds 1, only the author reads them.
    match /events/{id} {
      allow read: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id', 'authorId', 'type', 'day', 'count']) &&
        request.resource.data.id == id &&
        id == request.resource.data.authorId + '_' + request.resource.data.type + '_' + request.resource.data.day &&
        request.resource.data.type in ['listen', 'follow', 'download'] && request.resource.data.count == 1;
      allow update: if changedKeys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
    }

    // ---------------- Moderation ----------------

    match /projectReports/{id} {
      allow read: if isAdmin();
      allow create: if ownsProfile(request.resource.data.reporterId) &&
        request.resource.data.keys().hasOnly(['karaokeId', 'karaokeTitle', 'reporterId', 'type', 'details', 'status', 'createdAt']) &&
        request.resource.data.type in ['copyright', 'inappropriate', 'abuse', 'spam', 'other'] &&
        request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
        (request.resource.data.type != 'other' || request.resource.data.details.matches('(?s).*\\S.*')) &&
        request.resource.data.status == 'open' && request.resource.data.createdAt == request.time &&
        reportTargetsProject();
      allow update: if isAdminProfile(request.resource.data.reviewedBy) &&
        resource.data.status == 'open' && request.resource.data.status == 'reviewed' &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);

      function reportTargetsProject() {
        let project = getAfter(projectPath(request.resource.data.karaokeId)).data;
        return project.get('status', 'active') == 'active' && project.get('visibility', 'public') in ['public', 'unlisted'] &&
          project.authorId != request.resource.data.reporterId && project.title == request.resource.data.karaokeTitle;
      }
    }

    // Public site settings. `genres` (the list projects pick from) is edited by admins only.
    // `aligner` is not writable here: the auto-timing service would need to sign in first.
    match /config/{id} {
      allow read: if true;
      allow write: if id == 'genres' && isAdmin() &&
        request.resource.data.keys().hasOnly(['id', 'list']) && request.resource.data.id == 'genres' &&
        request.resource.data.list is list && request.resource.data.list.size() <= 200;
    }
  }
}
