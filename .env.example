# Copy to .env.local for local dev, and add the same variables in Vercel → Project → Settings → Environment Variables.

# Public site URL for Open Graph links, sitemap and robots.txt (optional, defaults to Vercel domain or localhost).
NEXT_PUBLIC_SITE_URL=https://karaokecraft.vercel.app

# Operator and contact shown on /terms, /privacy, /copyright and in the footer (optional: defaults in lib/legal.ts).
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase Storage (audio, covers and custom fonts). Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_BUCKET=uploads

# Server-only Supabase secret key (sb_secret_… or the legacy service_role key). Required in production:
# /api/storage/upload checks the Firebase ID token, a confirmed email and bans, then hands out a signed
# upload URL; /api/storage/delete removes files. Never prefix it with NEXT_PUBLIC_ (that would expose it).
# Without it the site falls back to direct anonymous uploads, which need supabase/storage.dev.sql.
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Firebase (optional: defaults for the karaoke-craft project are in lib/firebase.ts)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Local auto-timing service (aligner/). Default: http://localhost:8787
# Set to the tunnel URL if the service should work for other people without reading Firestore.
NEXT_PUBLIC_ALIGNER_URL=
